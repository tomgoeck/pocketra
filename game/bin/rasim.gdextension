[configuration]

entry_symbol = "rasim_library_init"
compatibility_minimum = "4.7"

[libraries]

macos.debug.arm64 = "res://bin/librasim.macos.arm64.dylib"
macos.release.arm64 = "res://bin/librasim.macos.arm64.dylib"
android.debug.arm64 = "res://bin/librasim.android.arm64.so"
android.release.arm64 = "res://bin/librasim.android.arm64.so"
ios.debug = "res://bin/librasim.ios.xcframework"
ios.release = "res://bin/librasim.ios.xcframework"
windows.debug.x86_64 = "res://bin/librasim.windows.x86_64.dll"
windows.release.x86_64 = "res://bin/librasim.windows.x86_64.dll"
web.debug.wasm32 = "res://bin/librasim.web.wasm32.wasm"
web.release.wasm32 = "res://bin/librasim.web.wasm32.wasm"
