android/pocketra_plugin/build/
android/pocketra_plugin/.gradle/
android/pocketra_plugin/local.properties
game/addons/pocketra_plugin/bin/*.aar

# Android-Bauvorlage fuer den Gradle-Bau der APK — erzeugt Godot aus android_source.zip
